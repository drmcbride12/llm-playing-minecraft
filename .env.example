# Copy this file to .env and edit the values for your machine.
#
# LM Studio's native local API URL is:
#   http://localhost:1234/api/v1
#
# LM Studio often accepts any non-empty local key. This project still requires
# one so the runtime contract is the same for local and remote-compatible APIs.
MINECRAFT_LLM_BASE_URL=http://localhost:1234/api/v1
MINECRAFT_LLM_API_KEY=lm-studio-local-development-key
MINECRAFT_LLM_MODEL=google/gemma-4-e4b

# Planner tuning. Keep temperature low while the action schema is young.
# The model is loaded in LM Studio with a 16,384-token context window.
MINECRAFT_LLM_CONTEXT_LENGTH=16384
MINECRAFT_LLM_TEMPERATURE=0.2
MINECRAFT_LLM_TIMEOUT_SECONDS=60

# Baritone runtime personality. "bold" enables aggressive pathing settings
# such as parkour, sprinting, block placement, water bucket falls, and higher
# fall tolerance. Use the CLI's baritone-profile command to print the #set list.
MINECRAFT_BARITONE_PROFILE=bold
